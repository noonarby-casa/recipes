{
  "name": "noonarby-casa-recipes",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "typecheck": "svelte-check --tsconfig tsconfig.json && tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"themes/cookpot/assets/js/**/*.{ts,svelte}\"",
    "lint:fix": "eslint \"themes/cookpot/assets/js/**/*.{ts,svelte}\" --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test --project=e2e",
    "test:e2e:ui": "playwright test --project=e2e --ui",
    "test:a11y": "playwright test --project=a11y",
    "test:a11y:ui": "playwright test --project=a11y --ui",
    "test:browser": "playwright test",
    "test:all": "pnpm run test:unit && pnpm run test:browser",
    "check:styles": "node scripts/check-style-rules.js",
    "ci": "pnpm run build && pnpm run typecheck & p1=$! ; pnpm run lint & p2=$! ; pnpm run format & p3=$! ; pnpm run check:styles & p4=$! ; pnpm run test:unit & p5=$! ; wait $p1 && wait $p2 && wait $p3 && wait $p4 && wait $p5",
    "fix": "pnpm run lint:fix && pnpm run format:fix",
    "clean": "node scripts/clean.js",
    "clean:all": "node scripts/clean.js --all"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.20.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.0",
    "prettier-plugin-go-template": "^0.0.15",
    "sirv-cli": "^3.0.1",
    "svelte": "^5.56.6",
    "svelte-check": "^4.7.3",
    "svelte-dnd-action": "^0.9.74",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.5",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vitest": "^4.1.10"
  }
}
